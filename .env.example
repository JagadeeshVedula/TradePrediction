# Telegram Bot Integration Setup
# 1. Open Telegram and search for @BotFather
# 2. Send /newbot command and follow prompt to get TELEGRAM_BOT_TOKEN
# 3. Add bot as Admin to your Telegram Channel or Group
# 4. Get TELEGRAM_CHAT_ID (e.g. -100xxxxxxxxxx or group/personal IDs)
# 5. You can specify multiple Chat IDs separated by commas (e.g. 8006589467,-1001234567890)
# 6. Run `python main.py --mode get-chats` to discover chat IDs where the bot is added!

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=chat_id1,chat_id2

# Supabase Configuration
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API to copy Project URL & anon/service_role API key
# 3. Create a Storage Bucket named 'ml-models' in Supabase Storage
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_api_key_here
SUPABASE_BUCKET=ml-models

